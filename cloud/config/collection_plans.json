{
  "sites": ["indeed", "linkedin"],
  "locations": [
    {"country_code": "CA"},
    {"country_code": "US"}
  ],
  "keyword_groups": [
    {
      "domain": "computer-science-software",
      "keywords": [
        "software engineer intern",
        "software developer intern",
        "software engineering co-op",
        "backend engineer intern",
        "frontend engineer intern",
        "full stack developer intern",
        "cloud devops intern",
        "cybersecurity intern",
        "embedded software intern"
      ]
    },
    {
      "domain": "data-science",
      "keywords": [
        "data science intern",
        "data analyst intern",
        "data engineer intern",
        "analytics intern"
      ]
    },
    {
      "domain": "machine-learning-ai",
      "keywords": [
        "machine learning engineer intern",
        "artificial intelligence intern",
        "applied scientist intern",
        "computer vision intern",
        "natural language processing intern",
        "MLOps intern"
      ]
    }
  ],
  "defaults": {
    "interval_seconds": 43200,
    "recent_hours": 48,
    "full_sweep_every": 30,
    "page_size": 25,
    "max_results_per_source": 40,
    "max_results_by_source": {"indeed": 1000},
    "page_size_by_source": {"indeed": 1000},
    "max_attempts": 3,
    "distance": 100,
    "linkedin_fetch_description": true,
    "linkedin_detail_ttl_seconds": 86400,
    "linkedin_detail_concurrency": 4,
    "linkedin_shard_budget_seconds": 2700,
    "linkedin_seen_window_seconds": 86400,
    "linkedin_details_budget_seconds": 2700,
    "linkedin_budget_seconds": 3600,
    "linkedin_detail_budget_seconds": 1800,
    "ats": {
      "enabled": true,
      "boards_path": "job_boards.json",
      "concurrency": 4,
      "include_new_grad": false,
      "budget_seconds": 2400,
      "boards_budget_seconds": 900,
      "workday_shard_budget_seconds": 2700,
      "simplify_detail_budget_seconds": 600,
      "stapply_enabled": true
    },
    "verbose": 1
  }
}
