{
  "$defs": {
    "JobListItem": {
      "properties": {
        "schema_version": {
          "const": "job.v1",
          "default": "job.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "company_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Company Name"
        },
        "location": {
          "$ref": "#/$defs/LocationResponse"
        },
        "work_mode": {
          "title": "Work Mode",
          "type": "string"
        },
        "employment_types": {
          "items": {
            "type": "string"
          },
          "title": "Employment Types",
          "type": "array"
        },
        "date_posted": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Posted"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "seniority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seniority"
        },
        "salary": {
          "anyOf": [
            {
              "$ref": "#/$defs/SalaryResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_count": {
          "title": "Source Count",
          "type": "integer"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "last_seen_at": {
          "format": "date-time",
          "title": "Last Seen At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "company_name",
        "location",
        "work_mode",
        "employment_types",
        "date_posted",
        "published_at",
        "seniority",
        "salary",
        "source_count",
        "first_seen_at",
        "last_seen_at"
      ],
      "title": "JobListItem",
      "type": "object"
    },
    "LocationResponse": {
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        }
      },
      "required": [
        "text",
        "city",
        "region",
        "country"
      ],
      "title": "LocationResponse",
      "type": "object"
    },
    "SalaryResponse": {
      "properties": {
        "interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "interval",
        "minimum",
        "maximum",
        "currency",
        "source"
      ],
      "title": "SalaryResponse",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "job-page.v1",
      "default": "job-page.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/JobListItem"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "has_more"
  ],
  "title": "JobPage",
  "type": "object"
}
