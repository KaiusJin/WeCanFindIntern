DATABASE_URL=postgresql://wecanfindintern:wecanfindintern@localhost:5432/wecanfindintern
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_STATEMENT_TIMEOUT_MS=5000
RECOMMEND_EMBEDDING_PROVIDER=Ollama
RECOMMEND_EMBEDDING_MODEL=qwen3-embedding:0.6b
RECOMMEND_EMBEDDING_DIMENSIONS=768
RECOMMEND_EMBEDDING_API_KEY=
RECOMMEND_EMBEDDING_API_BASE=http://localhost:11434
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_API_BASE=http://localhost:11434/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Cloud collector settings (unused by the desktop feed synchronizer).
WCFI_LINKEDIN_DETAIL_TTL_SECONDS=86400
WCFI_LINKEDIN_DETAIL_CONCURRENCY=4
WCFI_COLLECTION_RECENT_HOURS=48
WCFI_COLLECTION_FULL_SWEEP_EVERY=10

# Desktop public feed. Electron enables sync; development may override the URL.
WCFI_PUBLIC_JOBS_MANIFEST_URL=
WCFI_JOB_SYNC_INTERVAL_SECONDS=14400

# Interview answer transcription (faster-whisper, local). Model is downloaded on first use.
INTERVIEW_STT_MODEL=base
